{
    "name": "arrow",
    "buildsystem": "cmake-ninja",
    "subdir": "cpp",
    "config-opts": [
        "-DARROW_DEPENDENCY_SOURCE=SYSTEM",
        "-DARROW_BUILD_STATIC=OFF",
        "-DARROW_PARQUET=ON",
        "-DARROW_DATASET=ON",
        "-DARROW_COMPUTE=ON",
        "-DARROW_MIMALLOC=OFF",
        "-DARROW_WITH_BROTLI=ON",
        "-DARROW_WITH_BZ2=ON",
        "-DARROW_WITH_LZ4=ON",
        "-DARROW_WITH_SNAPPY=ON",
        "-DARROW_WITH_ZLIB=ON",
        "-DARROW_WITH_ZSTD=ON"
    ],
    "sources": [
        {
            "type": "archive",
            "url": "https://archive.apache.org/dist/arrow/arrow-26.0.0/apache-arrow-26.0.0.tar.gz",
            "sha256": "b153ef472dd89ef4cb84867ca238f2a3a9347d8f4a78913d16ca2201606f0425",
            "x-checker-data": {
                "type": "html",
                "url": "https://archive.apache.org/dist/arrow/",
                "version-pattern": "href=\"arrow-([0-9.]+)/\"",
                "url-template": "https://archive.apache.org/dist/arrow/arrow-$version/apache-arrow-$version.tar.gz"
            }
        }
    ],
    "modules": [
        {
            "name": "boost",
            "buildsystem": "simple",
            "build-commands": [
                "./bootstrap.sh --prefix=${FLATPAK_DEST} --with-icu",
                "./b2 install --with-headers -j ${FLATPAK_BUILDER_N_JOBS} headers variant=release threading=multi --layout=system"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://archives.boost.io/release/1.92.0/source/boost_1_92_0.tar.bz2",
                    "sha256": "5c1d40cb8e19adbf740a4ec2da35b3e58f3f5804b1dce44deb53df72193cbc6c",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 6845,
                        "url-template": "https://archives.boost.io/release/$version/source/boost_${major}_${minor}_$patch.tar.bz2"
                    }
                }
            ]
        },
        {
            "name": "rapidjson",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DRAPIDJSON_BUILD_DOC=OFF",
                "-DRAPIDJSON_BUILD_EXAMPLES=OFF",
                "-DRAPIDJSON_BUILD_TESTS=OFF",
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/miloyip/rapidjson/archive/232389d4f1012dddec4ef84861face2d2ba85709.tar.gz",
                    "sha256": "b9290a9a6d444c8e049bd589ab804e0ccf2b05dc5984a19ed5ae75d090064806"
                }
            ]
        },
        {
            "name": "thrift",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_SHARED_LIBS=ON",
                "-DBUILD_COMPILER=OFF",
                "-DBUILD_TESTING=OFF",
                "-DBUILD_TUTORIALS=OFF",
                "-DWITH_AS3=OFF",
                "-DWITH_C_GLIB=OFF",
                "-DWITH_JAVA=OFF",
                "-DWITH_JAVASCRIPT=OFF",
                "-DWITH_NODEJS=OFF",
                "-DWITH_PYTHON=OFF",
                "-DWITH_LIBEVENT=OFF",
                "-DWITH_OPENSSL=OFF",
                "-DWITH_QT5=OFF",
                "-DWITH_ZLIB=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://archive.apache.org/dist/thrift/0.25.0/thrift-0.25.0.tar.gz",
                    "sha256": "66da4707214c54c94bac082103dc67adaf9e08925662700f269170a7b534b214",
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://archive.apache.org/dist/thrift/",
                        "version-pattern": "href=\"([0-9.]+)/\"",
                        "url-template": "https://archive.apache.org/dist/thrift/$version/thrift-$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "snappy",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_SHARED_LIBS=ON",
                "-DSNAPPY_BUILD_TESTS=OFF",
                "-DSNAPPY_BUILD_BENCHMARKS=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/google/snappy/archive/1.3.1.tar.gz",
                    "sha256": "893f708a0bf4b5529d555ffcee390e940e932fcf90261f682604475a76cd0247",
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://github.com/google/snappy/tags",
                        "version-pattern": "/releases/tag/([0-9.]+)",
                        "url-template": "https://github.com/google/snappy/archive/$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "utf8proc",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_SHARED_LIBS=ON",
                "-DUTF8PROC_ENABLE_TESTING=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/JuliaStrings/utf8proc/archive/v2.12.0.tar.gz",
                    "sha256": "f564011d38b2888d583d510b08e69ffa15aa117155db1b9b49ef1dfe1fa25111",
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://github.com/JuliaStrings/utf8proc/tags",
                        "version-pattern": "/releases/tag/v([0-9.]+)",
                        "url-template": "https://github.com/JuliaStrings/utf8proc/archive/v$version.tar.gz"
                    }
                }
            ],
            "builddir": true
        },
        {
            "name": "re2",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_SHARED_LIBS=ON",
                "-DRE2_BUILD_TESTING=OFF",
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/google/re2/archive/2023-03-01.tar.gz",
                    "sha256": "7a9a4824958586980926a300b4717202485c4b4115ac031822e29aa4ef207e48"
                }
            ],
            "//": "Keep the last release before RE2 added an Abseil dependency; Arrow supports this version."
        },
        {
            "name": "xsimd",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TESTS=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/xtensor-stack/xsimd/archive/14.3.0.tar.gz",
                    "sha256": "b3d50e7a73fbf4642ceef30131c93414901d69eee41c2a5302db650b03e2c792",
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://github.com/xtensor-stack/xsimd/tags",
                        "version-pattern": "/releases/tag/([0-9.]+)",
                        "url-template": "https://github.com/xtensor-stack/xsimd/archive/$version.tar.gz"
                    }
                }
            ]
        }
    ],
    "builddir": true
}
